# ─── Required ────────────────────────────────────────────────────────────────
# Generate secrets with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ENCRYPTION_KEY=change-me-to-another-long-random-string-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Used by `pnpm dev` (docker compose overrides it for the web container)
DATABASE_URL=postgres://minibot:minibot@localhost:5432/minibot

# ─── Optional ────────────────────────────────────────────────────────────────
# Server-wide fallback key; users can also set their own key in Settings.
DEEPSEEK_API_KEY=

# Sandbox containers (one per conversation)
SANDBOX_IMAGE=minibot-sandbox:latest
# "none" = no network inside the sandbox; use "bridge" to allow pip/npm/curl.
SANDBOX_NETWORK=none
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=256
SANDBOX_IDLE_MINUTES=15
